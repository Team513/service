pipeline {
    agent any

    tools {
        jdk 'jdk21' 
    }

    environment {
        DOCKER_CREDENTIALS = credentials("DockerHub") 
        GITHUB_TOKEN = credentials("github_token")   
    }

    stages {
        stage('Build & Test') {
            steps {
                sh './gradlew clean build'
            }
        }

        stage('Tag image') {
            steps {
                script {
                    sh 'git fetch --tags'

                    def lastTag = sh(script: "git tag | sort -V | tail -1", returnStdout: true).trim()
                    if (lastTag == "") {
                        env.MAJOR_VERSION = "1"
                        env.MINOR_VERSION = "0"
                        env.PATCH_VERSION = "0"
                    } else {
                        def parts = lastTag.tokenize('.')
                        env.MAJOR_VERSION = parts[0]
                        env.MINOR_VERSION = parts[1]
                        env.PATCH_VERSION = parts[2]
                    }

                    def nextMinor = Integer.parseInt(env.MINOR_VERSION) + 1
                    env.IMAGE_TAG = "${env.MAJOR_VERSION}.${nextMinor}.${env.PATCH_VERSION}"
                }

                sh "docker build -t ${DOCKER_CREDENTIALS_USR}/hello-img:${IMAGE_TAG} ."
                sh "echo ${DOCKER_CREDENTIALS_PSW} | docker login -u ${DOCKER_CREDENTIALS_USR} --password-stdin"
                sh "docker push ${DOCKER_CREDENTIALS_USR}/hello-img:${IMAGE_TAG}"
                sh "git tag ${IMAGE_TAG}"
                sh "git push https://${GITHUB_TOKEN}@github.com/Team513/service.git ${IMAGE_TAG}"
            }
        }
    }
}
