pipeline {
    agent any

    tools {
        jdk 'jdk21' // This name must match the JDK installation name used in Jenkins Global Tool Configuration
    }
    environment {
        DOCKER_PASSWORD = credentials("docker_pass2")
        GITHUB_TOKEN = credentials("git_token22")
    }

    stages {
        stage('Build & Test') {
            steps {
                sh './gradlew clean build'
            }
        }

        stage('Tag image') {
            steps {
                script {
                    sh([script: 'git fetch --tag', returnStdout: true]).trim()
                    env.MAJOR_VERSION = sh([script: 'git tag | sort --version-sort | tail -1 | cut -d . -f 1', returnStdout: true]).trim()
                    env.MINOR_VERSION = sh([script: 'git tag | sort --version-sort | tail -1 | cut -d . -f 2', returnStdout: true]).trim()
                    env.PATCH_VERSION = sh([script: 'git tag | sort --version-sort | tail -1 | cut -d . -f 3', returnStdout: true]).trim()
                    env.IMAGE_TAG = "${env.MAJOR_VERSION}.\$((${env.MINOR_VERSION} + 1)).${env.PATCH_VERSION}"

                    sh "docker build -t bogdancomardici/hello-img:${IMAGE_TAG} ."
                    sh "echo ${DOCKER_PASSWORD} | docker login -u bogdancomardici --password-stdin"
                    sh "docker push bogdancomardici/hello-img:${IMAGE_TAG}"


                    sh "git tag ${env.IMAGE_TAG}"
                    sh "git push https://$GITHUB_TOKEN@github.com/bogdancomardici/service.git ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Docker Compose') {
            steps {
                script {
                    sh "IMAGE_TAG=${env.IMAGE_TAG} && docker compose up -d hello mongo"
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    sh "./gradlew testIT"
                }
            }
        }
    }
}
